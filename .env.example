PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT_MS=300000
# Hard ceiling on estimated input tokens per AI call (token-guard).
# Prevents sending an over-limit payload that would overflow the model context.
MAX_AI_INPUT_TOKENS=60000
LOG_LEVEL=info
ENABLE_METRICS=false
# Optional: model for the claude CLI (AI cleanup / framework mapping).
# Defaults to "haiku" (fast, sufficient for mechanical cleanup). "sonnet"/"opus"
# give higher fidelity but can stall on large payloads — prefer --collapse-variants.
# Note: the CLI uses your Claude subscription; running cleanup while you are
# actively using Claude Code shares the same account/rate-limit and slows both.
CLAUDE_MODEL=""
# Optional: per-call timeout for the claude CLI in ms (default 300000).
CLAUDE_TIMEOUT_MS=""
FIGMA_TOKEN=""